generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String        @id @default(uuid())
  email          String        @unique
  supertokenId   String        @unique
  name           String?
  cpf            String?
  job            String?
  createdAt      DateTime? @default(now())
  score          Int
  lastUpdate     DateTime?
  imageProfile   String?
  config         Json?
  posts          Post[]
  following      User[] @relation("UserFollowing")
  followers      User[] @relation("UserFollowing")
  journey        Journey[]
  medals         Medal[] @relation("UserMedals")
  progress       UserProgress[]
}

model Newspaper {
  id          String  @id @default(uuid())
  source      Json?
  author      String
  title       String
  description String?
  url         String
  urlToImage  String?
  publishedAt DateTime @default(now())
  content     String?
}

model Medal {
  id            String  @id @default(uuid())
  name          String
  description   String
  image         String?
  users         User[]  @relation("UserMedals")
}

model Post {
  id          String      @id @default(uuid())
  userId      String
  content     String
  publishedAt DateTime @default(now())
  userRel     User    @relation(fields: [userId], references: [id])
}

model Journey {
  id      String @id @default(uuid())
  userId  String
  name    String
  type    String
  user    User   @relation(fields: [userId], references: [id])
}

model Course {
  id            String @id @default(uuid())
  teacher       String
  teacherImage  String
  title         String
  duration      Int
  score      Int
  totalClasses  String
  videos        CourseVideo[]
  progress      UserProgress[]
}

model CourseVideo {
  id       String @id @default(uuid())
  courseId String
  course   Course @relation(fields: [courseId], references: [id])
  title    String
  duration Int
  link     String
}

model UserProgress {
  userId    String
  courseId  String
  userRel   User  @relation(fields: [userId], references: [id])
  courseRel Course @relation(fields: [courseId], references: [id])
  progress  Int
  @@id([userId, courseId])
}